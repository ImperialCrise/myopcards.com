APP_NAME=MyOPCards
APP_URL=https://myopcards.com
APP_ENV=production
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myopcards
DB_USERNAME=
DB_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://myopcards.com/auth/google/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://myopcards.com/auth/discord/callback

OPTCG_API_BASE=https://optcgapi.com/api
# Fallback when API omits card_image (promos, etc.): official EN card art PNGs
OP_OFFICIAL_CARD_IMAGE_BASE=https://en.onepiece-cardgame.com/images/cardlist/card

# DON!! images: OPECards.fr search (English art, HTML, no key) — ?language=EN
# DON_IMAGE_USE_OPECARDS=1
# TCGPlayer CDN via infinite-api (map don_* → product id in config/don_tcgplayer_product_ids.json)
# DON_IMAGE_USE_TCGPLAYER=1
# Optional proxy for OPECards + TCGPlayer API (PHP cannot read .ovpn).
# Docker NordVPN (Gluetun + config/fr912.nordvpn.com.udp.ovpn):
#   docker compose --profile nordvpn up -d gluetun
#   NORDVPN_USER=   NORDVPN_PASSWORD=   (Nord service credentials)
#   SCRAPING_HTTP_PROXY=http://127.0.0.1:8888
# Or host OpenVPN: sudo openvpn --config config/fr912.nordvpn.com.udp.ovpn
# Or SOCKS: SCRAPING_HTTP_PROXY=socks5h://127.0.0.1:1080
# SCRAPING_HTTP_PROXY=
# Build DON→TCGPlayer map (prefer search API): php bin/sync-don-tcgplayer-ids.php --search
# Fallback slow ID scan: php bin/sync-don-tcgplayer-ids.php --scan --from=605000 --to=730000

# Cardmarket: PHP → FlareSolverr (local). Cardmarket itself is fetched BY FlareSolverr.
# NordVPN: usually connect the host (OpenVPN .ovpn) or a sidecar (e.g. Gluetun) so FlareSolverr egress uses VPN.
# Only if PHP cannot reach FlareSolverr without a proxy:
# CARDMARKET_FLARE_CURL_PROXY=socks5h://user:pass@127.0.0.1:1080

FLARESOLVERR_URL=http://127.0.0.1:8192/v1

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=forum-uploads
